{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:mvp",
  "outputDirectory": "dist",
  "functions": {
    "api/tutor.mjs": {
      "includeFiles": "shared/ohm.json",
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/pitch", "destination": "/pitch/index.html" },
    { "source": "/materias/:path*", "destination": "/index.html" },
    { "source": "/biblioteca", "destination": "/index.html" },
    { "source": "/calendario/:path*", "destination": "/index.html" },
    { "source": "/perfil", "destination": "/index.html" },
    { "source": "/agenda", "destination": "/index.html" },
    { "source": "/horario", "destination": "/index.html" }
  ]
}
